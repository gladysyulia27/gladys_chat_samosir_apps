# Better Auth configuration (required)
# Public URL of the deployed application
BETTER_AUTH_URL=https://your-app.vercel.app
# Signing secret for sessions/tokens. Generate with: `bun x @better-auth/cli secret`
BETTER_AUTH_SECRET=replace-with-a-generated-secret

# Google Maps (optional, enables the interactive map instead of the embedded fallback)
# Create a browser key at https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=
